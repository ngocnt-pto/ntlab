rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Hồ sơ người dùng & dữ liệu từng phần mềm (/go-may, /man-hinh-desktop, ...)
    // Chỉ chính chủ tài khoản Google mới được đọc/ghi dữ liệu của mình
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /apps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 2. Kho Mã Kích Hoạt (1 Mã = 1 Tài khoản Google duy nhất)
    // Cấm quét danh sách (allow list: if false), chỉ cho phép kiểm tra & khóa mã khi chưa có chủ
    match /licenses/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && code.matches('^(ALL|GM|MD|DN)-[2-9A-HJ-NP-Z]{6}-[2-9A-HJ-NP-Z]{4}$')
        && request.resource.data.code == code
        && request.resource.data.claimedBy == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedBy == request.auth.uid;

      allow delete: if false;
    }
  }
}
