rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kiểm tra người dùng đã đăng nhập Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // CHỈ DUY NHẤT tài khoản Admin tuanngocpt@gmail.com (đã xác thực email Google)
    // mới có quyền quản trị bảng giá, xem thống kê toàn hệ thống và chỉnh sửa thời hạn VIP
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'tuanngocpt@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 1. Cấu hình Bảng Giá, Thời hạn Gói VIP & Tài khoản VietQR (settings/catalog)
    // Mọi người dùng đều được đọc (get) để hiển thị giá & QR, nhưng CHỈ Admin mới được ghi/sửa
    match /settings/{docId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // 2. Hồ sơ người dùng & dữ liệu từng phần mềm (/go-may, /man-hinh-desktop, ...)
    // - Người dùng thường chỉ đọc/cập nhật dữ liệu cá nhân của chính mình, cấm quét danh sách (list)
    // - Admin (tuanngocpt@gmail.com) được phép đọc danh sách (list) để thống kê và chỉnh sửa thời hạn VIP
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == uid
        && (!('adminGranted' in request.resource.data) || request.resource.data.adminGranted == false)
      );

      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == uid
        && (!('adminGranted' in request.resource.data) || request.resource.data.adminGranted == resource.data.adminGranted)
      );

      allow delete: if isAdmin();

      match /apps/{appId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // 3. Thống kê thiết bị truy cập, người dùng thử & lượt tải phần mềm (visitors/{visitorId})
    // - Cho phép ghi nhận lượt truy cập / dùng thử / tải phần mềm theo mã định danh thiết bị
    // - Cấm người dùng thường quét danh sách (list); CHỈ Admin mới được list để xem báo cáo thống kê
    match /visitors/{visitorId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        visitorId.matches('^v-[a-zA-Z0-9_-]{8,40}$')
        && (!('isVip' in request.resource.data) || request.resource.data.isVip is bool)
      );
      allow delete: if isAdmin();
    }

    // 4. Kho Mã Kích Hoạt VIP & Thời hạn gói (1 Mã = 1 Tài khoản Google duy nhất)
    // - Cấm người dùng thường quét danh sách mã (allow list: if isAdmin())
    // - Cho phép kiểm tra & khóa mã (claim) khi mã chưa có chủ hoặc thuộc về chính mình
    // - CHỈ Admin mới được tạo trước kho mã có thời hạn tùy chỉnh hoặc thu hồi/sửa mã
    match /licenses/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isSignedIn()
        && code.matches('^(ALL|GM|MD|DN)-[2-9A-HJ-NP-Z]{6}-[2-9A-HJ-NP-Z]{4}$')
        && request.resource.data.code == code
        && request.resource.data.claimedBy == request.auth.uid
        && (!('revoked' in request.resource.data) || request.resource.data.revoked == false)
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && (resource.data.claimedBy == null || resource.data.claimedBy == '' || resource.data.claimedBy == request.auth.uid)
        && request.resource.data.claimedBy == request.auth.uid
        && (!('revoked' in resource.data) || resource.data.revoked == false)
      );

      allow delete: if isAdmin();
    }

    // 5. Đơn hàng Thanh Toán Tự Động VietQR (orders/{orderCode})
    // - Khách hàng chỉ được tạo đơn ở trạng thái 'pending' (chưa có mã kích hoạt) và lắng nghe đúng mã đơn của mình
    // - Tuyệt đối CẤM khách tự cập nhật trạng thái 'paid' từ trình duyệt
    // - CHỈ Admin (tuanngocpt@gmail.com) hoặc Google Apps Script của Admin mới được duyệt đơn ('paid') và cấp mã
    match /orders/{orderCode} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        orderCode.matches('^NTLAB-(ALL|GM|MD|DN)-[2-9A-HJ-NP-Z]{6}$')
        && request.resource.data.orderCode == orderCode
        && request.resource.data.status == 'pending'
        && (!('licenseCode' in request.resource.data) || request.resource.data.licenseCode == null || request.resource.data.licenseCode == '')
      );

      allow update, delete: if isAdmin();
    }
  }
}
